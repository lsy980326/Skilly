{
  "name": "skilly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local project memory tools for existing coding agents",
  "engines": { "node": ">=24.0.0" },
  "bin": { "skilly": "dist/runtime/local/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:d1": "npm run build && node --test --test-concurrency=2 tests/d1-runtime.test.mjs tests/d1-work.test.mjs tests/d1-decisions-plans.test.mjs tests/d1-executions.test.mjs tests/d1-task-events.test.mjs tests/d1-skills.test.mjs",
    "start": "node dist/runtime/local/main.js serve",
    "view": "npm run build && node dist/runtime/local/viewer.js",
    "viewer": "node dist/runtime/local/viewer-manager.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "bench:stability": "npm run build && node scripts/bench-stability.mjs",
    "setup:codex": "npm run build && node scripts/setup-codex.mjs",
    "setup:hooks": "npm run build && node scripts/setup-codex-hooks.mjs",
    "doctor": "node scripts/doctor.mjs",
    "memory:inspect": "node scripts/inspect-memory.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "workerd": "1.20260730.1"
  }
}
